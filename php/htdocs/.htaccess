# ============================================================================
# DirIA Angola — Configuração Apache (InfinityFree / cPanel)
#
# Coloca este ficheiro em htdocs/.htaccess (raiz do site).
# Se o File Manager já mostrar conteúdo no .htaccess, ADICIONA estas regras
# no fim em vez de substituir tudo.
# ============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Nunca reescrever o próprio front controller da API (evita ciclos)
  RewriteRule ^api/index\.php$ - [L]

  # Endpoints da API -> front controller PHP
  RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

  # Ficheiros e pastas que existem (assets, imagens, favicon, ...)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback (React Router)
  RewriteRule ^ index.html [L]
</IfModule>

# Índice por omissão
DirectoryIndex index.html index.php

# Proteger credenciais e ficheiros de suporte (o PHP continua a poder incluí-los)
<FilesMatch "^(config\.local\.php|config\.php|composer\.(json|lock))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Depois de concluíres a instalação, descomenta para bloquear o assistente:
# <Files "setup.php">
#   <IfModule mod_authz_core.c>
#     Require all denied
#   </IfModule>
# </Files>

# UTF-8 por omissão
AddDefaultCharset UTF-8
